# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/esms

# CORS
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Auth (JWT_SECRET is REQUIRED in production; must be 32+ characters)
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30

# Initial super admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@esms.local
SEED_ADMIN_PASSWORD=ChangeMe!2026#Admin

# Optional demo users, one per role (development only)
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=Demo!User2026#
